// SDF sculptures on a floor: one composition for the scene, baked into a 3D texture cache
// (sdf/sdf-cache.slang) and sampled -- by the raymarching and by every soft shadow.
// sdf-controls.lua: C the DAG / the cache / its error, [ ] resolution, B benchmark, J K blend.
{
    "name": "SDF gallery",
    "settings": { "background": [0.03, 0.035, 0.045] },
    "entities": [
        { "id": "light", "transform": { "position": [0, 2.5, 0] },
          "light": { "color": [1.0, 0.9, 0.8], "intensity": 16, "range": 16, "orbitRadius": 2.5, "speed": 0.4 } },
        { "id": "floor", "prefab": "floor", "transform": { "position": [0, -0.87, 0] } },

        { "id": "sculpture", "prefab": "sculpture", "transform": { "position": [-1.6, 0, 0], "rotation": [0, 30, 0] },
          "repeat": { "count": 3, "step": [1.6, 0, 0], "rotationStep": [0, 40, 0] } },
        { "id": "arch", "transform": { "position": [0, -0.2, -1.6] },
          "sdf": { "cache": 160, "shape": {
              "subtract": [
                  { "box": [3.4, 1.3, 0.4], "color": [0.85, 0.82, 0.75] },
                  { "union": [
                      { "cylinder": { "radius": 0.45, "height": 1 }, "rotation": [90, 0, 0], "position": [-1, -0.2, 0] },
                      { "cylinder": { "radius": 0.45, "height": 1 }, "rotation": [90, 0, 0], "position": [0, -0.2, 0] },
                      { "cylinder": { "radius": 0.45, "height": 1 }, "rotation": [90, 0, 0], "position": [1, -0.2, 0] },
                  ] },
              ],
              "smooth": 0.05,
          } } },

        { "id": "controls", "script": { "file": "sdf-controls.lua" } },
        { "id": "camera", "camera": { "controller": "orbit", "target": [0, -0.2, -0.3], "distance": 5.5, "yaw": 10, "pitch": 20 } },
    ],
}
