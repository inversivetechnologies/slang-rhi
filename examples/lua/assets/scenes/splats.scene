// The Gaussian splats (`splat.lua`) as a scene: three skulls over a floor, with music, each
// showing what can be done to splats -- clipped per pixel by a slab sweeping down and up
// through the first (shaders/splat/clip.slang); colored by a sphere going round the
// second, and pushed away from a smaller one going round the third (both by the effects,
// shaders/splat/effect-field.slang: the two are dynamic). The splat mode's keys are
// behaviors/splat-controls.lua's: , . budget, / LOD tint, [ ] size, L lighting, C clip.
{
    "name": "Splat effects",
    "settings": { "background": [0.02, 0.02, 0.025], "splatBudget": 1000000 },
    "entities": [
        { "id": "light", "transform": { "position": [0, 5, 0] },
          "light": { "color": [1.0, 0.95, 0.85], "intensity": 60, "range": 30, "orbitRadius": 4, "speed": 0.2 } },
        { "id": "floor", "prefab": "floor", "transform": { "position": [0, -1.75, 0], "scale": 2 } },

        // 1: clipping. A slab carving a slice out, sweeping from the top to the bottom.
        { "id": "skull-clip", "prefab": "skull", "transform": { "position": [-4.5, 0, 0] },
          "splat": {
              "clip": { "mode": "carve", "shapes": [
                  { "box": [4, 0.5, 4], "position": [-4.5, 0.6, 0], "move": [0, 1.7, 0], "speed": 0.6 },
              ] },
          } },

        // 2: color. A sphere going round the skull, tinting what it passes through.
        { "id": "skull-color", "prefab": "skull", "transform": { "position": [0, 0, 0] },
          "splat": {
              "effects": [
                  { "color": [1.0, 0.25, 0.05], "strength": 0.9, "sphere": 0.8, "position": [0, 0.5, 0],
                    "orbit": 0.9, "orbitSpeed": 0.8, "move": [0, 0.9, 0], "speed": 0.5 },
              ],
          } },

        // 3: displacement. A smaller sphere going round it, pushing the splats away from its
        // center.
        { "id": "skull-displace", "prefab": "skull", "transform": { "position": [4.5, 0, 0] },
          "splat": {
              "effects": [
                  { "displace": 0.5, "sphere": 0.6, "position": [4.5, 0.5, 0],
                    "orbit": 0.8, "orbitSpeed": 1.1, "move": [0, 0.9, 0], "speed": 0.7 },
              ],
          } },

        { "id": "music", "sound": { "file": "audio/timelapse.mpeg", "loop": true } },
        { "id": "controls", "script": { "file": "splat-controls.lua" } },
        { "id": "camera", "camera": { "controller": "orbit", "target": [0, 0.4, 0], "distance": 9, "yaw": 0, "pitch": 12 } },
    ],
}
