// The physics playground (showcase mode 1) as a scene: a ball rolls down a ramp into a row
// of dominoes, the last topples into a box pyramid; a tower stands beside them. The player
// runs through it all (behaviors/player.lua); B drops boxes and balls from the sky.
{
    "name": "Physics",
    "settings": { "background": [0.015, 0.018, 0.025] },
    "entities": [
        { "id": "light", "transform": { "position": [0, 6.5, 0] },
          "light": { "color": [1.0, 0.92, 0.8], "intensity": 55, "range": 30, "orbitRadius": 3.5,
                     "speed": 0.15, "phase": 0.5, "bob": 0.4 } },

        { "id": "floor", "prefab": "floor", "transform": { "position": [0, -0.58, 0], "scale": 2.33 } },

        // The ramp, rising toward +x, and its rails.
        { "id": "ramp", "transform": { "position": [5.6, 0.62, 0], "rotation": [0, 0, 22] },
          "mesh": { "shape": "box", "size": [3.2, 0.16, 1.1], "color": [0.55, 0.5, 0.45] },
          "body": { "motion": "static", "friction": 0.4 },
          "children": [
              { "id": "rail", "transform": { "position": [0, 0.1, 0.6] },
                "mesh": { "shape": "box", "size": [3.2, 0.24, 0.08], "color": [0.45, 0.42, 0.38] }, "body": { "motion": "static" } },
              { "id": "rail", "transform": { "position": [0, 0.1, -0.6] },
                "mesh": { "shape": "box", "size": [3.2, 0.24, 0.08], "color": [0.45, 0.42, 0.38] }, "body": { "motion": "static" } },
          ] },
        { "id": "ball", "transform": { "position": [6.9, 1.4, 0] },
          "mesh": { "shape": "sphere", "radius": 0.22, "color": [0.95, 0.95, 0.95], "pattern": 1 },
          "body": { "density": 2500, "friction": 0.3, "restitution": 0.2 } },

        // Dominoes from the foot of the ramp toward -x.
        { "id": "domino", "prefab": "domino", "transform": { "position": [3.6, 0.42, 0] },
          "repeat": { "count": 14, "step": [-0.46, 0, 0],
                      "vary": { "mesh": { "color": [[0.90, 0.35, 0.28], [0.30, 0.55, 0.90], [0.95, 0.75, 0.25],
                                                   [0.35, 0.75, 0.45], [0.70, 0.40, 0.85], [0.90, 0.55, 0.20]] } } } },

        // The pyramid where the dominoes end: seven rows, each one shorter.
        { "id": "crate", "prefab": "crate", "transform": { "position": [-5.2, 0.2, 0] }, "repeat": { "count": 7, "step": [0.4, 0, 0] } },
        { "id": "crate", "prefab": "crate", "transform": { "position": [-5.0, 0.6, 0] }, "repeat": { "count": 6, "step": [0.4, 0, 0] },
          "mesh": { "color": [0.95, 0.75, 0.25] } },
        { "id": "crate", "prefab": "crate", "transform": { "position": [-4.8, 1.0, 0] }, "repeat": { "count": 5, "step": [0.4, 0, 0] },
          "mesh": { "color": [0.35, 0.75, 0.45] } },
        { "id": "crate", "prefab": "crate", "transform": { "position": [-4.6, 1.4, 0] }, "repeat": { "count": 4, "step": [0.4, 0, 0] },
          "mesh": { "color": [0.70, 0.40, 0.85] } },
        { "id": "crate", "prefab": "crate", "transform": { "position": [-4.4, 1.8, 0] }, "repeat": { "count": 3, "step": [0.4, 0, 0] },
          "mesh": { "color": [0.90, 0.55, 0.20] } },
        { "id": "crate", "prefab": "crate", "transform": { "position": [-4.2, 2.2, 0] }, "repeat": { "count": 2, "step": [0.4, 0, 0] },
          "mesh": { "color": [0.90, 0.35, 0.28] } },
        { "id": "crate", "prefab": "crate", "transform": { "position": [-4.0, 2.6, 0] } },

        // The tower: twelve layers of three boards, each layer a quarter turn from the last.
        { "id": "tower", "prefab": "tower-layer", "transform": { "position": [0.5, 0.1, 3.2] },
          "repeat": { "count": [1, 12, 1], "step": [0, 0.2, 0], "rotationStep": [0, 90, 0] } },

        { "id": "player", "transform": { "position": [0, 0.05, -5] }, "script": { "file": "player.lua" } },
        { "id": "sky", "transform": { "position": [0, 0, 0] }, "script": { "file": "burst.lua", "params": { "key": "B" } } },

        { "id": "camera", "camera": { "controller": "player", "fov": 55 } },
    ],
}
