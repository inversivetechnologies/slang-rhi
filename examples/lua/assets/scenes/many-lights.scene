// Many lights: 256 colored lamps (point lights without shadows, culled per screen tile:
// scene/light-culling.slang) hovering over a floor in a 16 x 16 grid, each circling a spot
// of its own, over meshes, the skull's splats and an SDF sculpture -- all three lit by
// them alike. A dim key light still shadows everything. The title gives the culling's GPU
// time.
{
    "name": "Many lights",
    "settings": { "background": [0.01, 0.012, 0.018] },
    "entities": [
        { "id": "key light", "transform": { "position": [3, 6, -4] },
          "light": { "color": [0.7, 0.75, 1.0], "intensity": 6, "range": 20 } },

        { "id": "floor", "prefab": "floor", "transform": { "position": [0, -1.25, 0] } },

        // The lamps: one entity, repeated; colors, speeds and phases cycle through their
        // lists (the light's and its marker's colors in step).
        { "id": "lamp", "prefab": "lamp", "transform": { "position": [-5.25, -0.75, -5.25] },
          "light": { "intensity": 1.3, "range": 1.1, "orbitRadius": 0.25, "speed": 1, "bob": 0.15 },
          "mesh": { "radius": 0.05 },
          "repeat": { "count": [16, 1, 16], "step": [0.7, 0, 0.7],
                      "vary": {
                          "light": {
                              "color": [[1.0, 0.25, 0.15], [1.0, 0.7, 0.15], [0.4, 1.0, 0.2], [0.15, 0.9, 1.0],
                                        [0.3, 0.4, 1.0], [0.85, 0.3, 1.0], [1.0, 0.35, 0.6]],
                              "speed": [1.1, -0.8, 1.5, -1.3, 0.7],
                              "phase": [0.0, 2.1, 4.2],
                          },
                          "mesh": {
                              "color": [[1.0, 0.25, 0.15], [1.0, 0.7, 0.15], [0.4, 1.0, 0.2], [0.15, 0.9, 1.0],
                                        [0.3, 0.4, 1.0], [0.85, 0.3, 1.0], [1.0, 0.35, 0.6]],
                          },
                      } } },

        // What they light: a ring of boxes and balls, the skull (splats), the sculpture (SDF).
        // (A ring: the parent turned per copy, the child placed out from it.)
        { "id": "boxes", "transform": { "position": [0, -0.6, 0] },
          "repeat": { "count": 6, "step": [0, 0, 0], "rotationStep": [0, 60, 0] },
          "children": [ { "id": "box", "transform": { "position": [3.4, 0, 0], "rotation": [0, 20, 0] },
                          "mesh": { "shape": "box", "size": [0.9, 0.9, 0.9], "color": [0.75, 0.75, 0.78] } } ] },
        { "id": "balls", "transform": { "position": [0, -0.6, 0], "rotation": [0, 30, 0] },
          "repeat": { "count": 6, "step": [0, 0, 0], "rotationStep": [0, 60, 0] },
          "children": [ { "id": "ball", "transform": { "position": [4.4, -0.15, 0] },
                          "mesh": { "shape": "sphere", "radius": 0.45, "color": [0.8, 0.8, 0.82] } } ] },
        { "id": "skull", "prefab": "skull", "transform": { "position": [-1.0, -0.35, -0.6], "rotation": [0, 30, 0] } },
        { "id": "sculpture", "prefab": "sculpture", "transform": { "position": [1.3, -0.38, 0.9] } },

        { "id": "splat controls", "script": { "file": "splat-controls.lua" } },
        { "id": "sdf controls", "script": { "file": "sdf-controls.lua" } },
        { "id": "camera", "camera": { "controller": "orbit", "target": [0, -0.6, 0], "distance": 9.5,
                                       "yaw": 25, "pitch": 32, "fov": 50, "turn": 6 } },
    ],
}
